{
  "expo": {
    "name": "NeverSoft Services",
    "slug": "neversoft-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#0a0a0a",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.neversoft.services"
    },
    "android": {
      "package": "com.neversoft.services",
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "sqlitePath": "neversoft.db"
        }
      ]
    ]
  }
}